# ============================================================
# .env.local — Produção (app-nodejs / 34.182.114.65)
# Copie para .env.local e preencha os valores reais
# ============================================================

# Banco de dados (PostgreSQL via docker-compose.prod.yml — porta 127.0.0.1:5432)
DATABASE_URL="postgresql://meuzapdesk:TROQUE_SENHA_DB@127.0.0.1:5432/meuzapdesk_prod"

# NextAuth
NEXTAUTH_SECRET="GERE_COM: openssl rand -base64 32"
NEXTAUTH_URL="https://app.meuzapdesk.com.br"

# Redis (via docker-compose.prod.yml — porta 127.0.0.1:6379)
REDIS_URL="redis://127.0.0.1:6379"

# WAHA (via docker-compose.prod.yml — porta 127.0.0.1:3100)
WAHA_API_URL="http://127.0.0.1:3100"
WAHA_API_KEY="TROQUE_POR_CHAVE_SEGURA"
WAHA_WEBHOOK_SECRET="TROQUE_POR_SECRET_SEGURO"
# WAHA (Docker) chama o panel via host.docker.internal
WAHA_WEBHOOK_BASE_URL="http://host.docker.internal:3004"

# Alertas de SLA (minutos)
ALERT_WARN_MINUTES=10
ALERT_URGENT_MINUTES=30
